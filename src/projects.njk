---
layout: base.njk
title: Projects
---

<section class="content">
    <h1>Projects</h1>
    <p>Here's a selection of projects I'm working on or have been involved in.</p>
</section>

<section class="content">
{% for project in collections.projects %}
    <article class="project">
        <h2>{{ project.data.title }}</h2>
        <p class="project-description">{{ project.data.description }}</p>
        <div class="project-tags">
            {% for tag in project.data.tags %}
            <span>{{ tag }}</span>
            {% endfor %}
        </div>
        {% if project.data.url %}
        <a href="{{ project.data.url }}" target="_blank" rel="noopener" class="project-link">View on GitHub &rarr;</a>
        {% endif %}
    </article>
{% endfor %}
</section>

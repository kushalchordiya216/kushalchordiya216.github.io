---
layout: base.njk
---

<article class="blog-post">
    <header>
        <h1>{{ title }}</h1>
        <p class="post-date">{{ date | readableDate }}</p>
    </header>
    <div class="content">
        {{ content | safe }}
    </div>
    {% if tags %}
    <div class="project-tags">
        {% for tag in tags %}
        <span>{{ tag }}</span>
        {% endfor %}
    </div>
    {% endif %}
    {% if url %}
    <a href="{{ url }}" target="_blank" rel="noopener" class="project-link">View on GitHub &rarr;</a>
    {% endif %}
</article>
